{
  "name": "pipedrive-euvino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pipedrive contacts screen built with the EuvinoPRO design system (@euvino/ds).",
  "scripts": {
    "dev": "vite --port 4340 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4340",
    "typecheck": "tsc --noEmit",
    "ds:check": "npm --prefix ../euvinopro-ds run -s ds -- check $PWD/src/App.tsx",
    "sync-ds": "node scripts/sync-ds.mjs && npm install"
  },
  "dependencies": {
    "@euvino/ds": "file:./vendor/euvino-ds",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^5.4.21"
  }
}
